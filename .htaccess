# FastAPI on cPanel - Apache Configuration
# This file helps route requests to the Python application

# Enable rewrite engine
RewriteEngine On

# If the file exists, serve it directly
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d

# Route all requests to passenger_wsgi.py
RewriteRule ^(.*)$ passenger_wsgi.py/$1 [L]

# Set Python version (adjust if needed)
# AddHandler python-script .py

# Prevent access to sensitive files
<FilesMatch "^(\.env|\.git|requirements\.txt)$">
    Order allow,deny
    Deny from all
</FilesMatch>

# Allow CORS (adjust domains as needed)
<IfModule mod_headers.c>
    Header set Access-Control-Allow-Origin "*"
    Header set Access-Control-Allow-Methods "GET, POST, PUT, DELETE, OPTIONS"
    Header set Access-Control-Allow-Headers "Content-Type, Authorization"
</IfModule>
