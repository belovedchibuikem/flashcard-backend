# ============================================
# AI-Powered Smart Flashcard Generator
# Environment Configuration File
# ============================================
# INSTRUCTIONS:
# 1. Copy this file and rename it to .env
# 2. Fill in your actual API keys and values
# 3. Never commit .env to Git (it's already in .gitignore)
# ============================================

# ============================================
# DATABASE CONFIGURATION
# ============================================
# PostgreSQL Database Connection String (RECOMMENDED for Vercel)
# Format: postgresql://username:password@host:port/database
# Examples:
#   Local PostgreSQL: postgresql://postgres:password@localhost:5432/flashcard_db
#   Vercel Postgres: postgres://user:pass@host.vercel-postgres.com:5432/dbname
#   Supabase: postgresql://postgres:password@db.xxxxx.supabase.co:5432/postgres
#   Neon: postgresql://user:pass@ep-xxxxx.us-east-2.aws.neon.tech/dbname
DATABASE_URL=postgresql://postgres:password@localhost:5432/flashcard_db

# MySQL Database Connection String (Alternative)
# Format: mysql+pymysql://username:password@host:port/database
# For WAMP default: root user with no password
# DATABASE_URL=mysql+pymysql://root:@localhost:3306/flashcard_db

# ============================================
# OPENAI CONFIGURATION (REQUIRED)
# ============================================
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here
# Model options: gpt-4, gpt-4-turbo-preview, gpt-4o
OPENAI_MODEL=gpt-4-turbo-preview

# ============================================
# ANTHROPIC CLAUDE (OPTIONAL - For Long Documents)
# ============================================
# Get your API key from: https://console.anthropic.com/
# Claude 3.5 Sonnet is excellent for long documents (200K context)
ANTHROPIC_API_KEY=

# ============================================
# GOOGLE GEMINI (OPTIONAL - For Fast/Cost-Efficient Tasks)
# ============================================
# Get your API key from: https://makersuite.google.com/app/apikey
# Gemini 2.5 Flash-Lite is fast and cost-efficient
GOOGLE_GEMINI_API_KEY=

# ============================================
# OCR SERVICES CONFIGURATION
# ============================================

# Google Cloud Vision API (Primary OCR - Good for general use)
# Get credentials from: https://console.cloud.google.com/apis/credentials
GOOGLE_CLOUD_VISION_API_KEY=
GOOGLE_APPLICATION_CREDENTIALS=

# Azure Computer Vision (BEST for Handwritten Notes - 98%+ accuracy)
# Get from: https://azure.microsoft.com/en-us/services/cognitive-services/computer-vision/
AZURE_VISION_KEY=
AZURE_VISION_ENDPOINT=https://your-region.api.cognitive.microsoft.com/

# AWS Textract (BEST for Documents - 99%+ accuracy)
# Get from: https://aws.amazon.com/textract/
# Note: AWS credentials are configured via AWS_ACCESS_KEY_ID and AWS_SECRET_ACCESS_KEY below

# ============================================
# FILE STORAGE CONFIGURATION
# ============================================
# Storage type: local, s3, or cloudinary
STORAGE_TYPE=local

# AWS S3 Configuration (Optional - for cloud storage)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET_NAME=flashcard-uploads
AWS_REGION=us-east-1

# Cloudinary Configuration (Optional - for cloud storage)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ============================================
# SERVER CONFIGURATION
# ============================================
# API Server Host and Port
API_HOST=0.0.0.0
API_PORT=8000
# Debug mode (True for development, False for production)
DEBUG=True

# ============================================
# JWT AUTHENTICATION CONFIGURATION
# ============================================
# IMPORTANT: Change this to a random secret key in production!
# Generate a secure key: openssl rand -hex 32
JWT_SECRET_KEY=your-secret-key-change-in-production-please-use-random-string-here
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# ============================================
# CORS CONFIGURATION
# ============================================
# Allowed origins for CORS (comma-separated)
# Add your frontend URLs here
CORS_ORIGINS=http://localhost:3000,http://localhost:8080,http://localhost:8000

# ============================================
# UPLOAD SETTINGS
# ============================================
# Maximum upload size (50MB default)
MAX_UPLOAD_SIZE=52428800

# ============================================
# NOTES
# ============================================
# 1. REQUIRED: OpenAI API Key (for flashcard generation)
# 2. REQUIRED: Database URL (PostgreSQL or MySQL connection)
# 3. OPTIONAL: Azure Vision Key (for better handwritten OCR - 98%+ accuracy)
# 4. OPTIONAL: AWS Textract (for better document OCR - 99%+ accuracy)
# 5. OPTIONAL: Claude API Key (for long documents - 200K context)
# 6. OPTIONAL: Gemini API Key (for fast/cost-efficient generation)
#
# For best accuracy (99.9% target):
# - Use AWS Textract for documents
# - Use Azure Read API for handwritten notes
# - Use GPT-4 Turbo for content generation
# - Use Claude 3.5 Sonnet for long documents
#
# See AI_MODELS_UPGRADE_GUIDE.md for detailed information

